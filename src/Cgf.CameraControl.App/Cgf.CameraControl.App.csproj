<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
    <AssemblyName>CgfCameraControl</AssemblyName>
    <RootNamespace>Cgf.CameraControl.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Reflection-based bindings are silently dropped by trimming, so every binding compiles. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Label="NativeAOT">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      AtemSharp builds its command registry with Assembly.GetTypes() and then reflects over the
      resolved command type, and HidSharp reflects inside itself too. IL2104 is the one summary
      warning each of them raises as a whole assembly, so it cannot be scoped to a call site.
      ILLink.Descriptors.xml in Cgf.CameraControl.Atem preserves AtemSharp whole, and the published
      binary is checked with the aot-probe switch, which fails loudly if the registry ever comes up
      empty. Trim warnings in this repository's own code still fail the build.
    -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="AtemSharp" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Manifest resources, not resx satellites: NativeAOT does not load satellite assemblies. -->
    <EmbeddedResource Include="Localization\Strings\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the assembly by the licence source generator along with the text of every
         licence they name, so the notices shown cannot drift from what the application ships and
         showing them costs nothing at run time. The package report is generated before the build
         rather than committed, because it names the versions actually restored, and only the
         packages the runtime identifier being published for resolves anything from. -->
    <AdditionalFiles Include="Licenses\*.json" />
    <AdditionalFiles Include="Licenses\texts\**\*.txt" />
    <ProjectReference Include="..\Cgf.CameraControl.Licenses.Generator\Cgf.CameraControl.Licenses.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Absent, the generator would credit the artwork alone and say nothing, because the hand-written
       artwork report is a licence report too. -->
  <Target Name="RequireLicenceReport" BeforeTargets="BeforeCompile">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/Licenses/third-party-licenses.json')"
           Text="The third party licence report is missing. Run: dotnet tool restore &amp;&amp; python packaging/licenses/fetch-texts.py --report-only" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cgf.CameraControl.Core\Cgf.CameraControl.Core.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Atem\Cgf.CameraControl.Atem.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Cameras.SignalrPtzLanc\Cgf.CameraControl.Cameras.SignalrPtzLanc.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Cameras.ViscaOverIp\Cgf.CameraControl.Cameras.ViscaOverIp.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Cameras.WebsocketPtzLanc\Cgf.CameraControl.Cameras.WebsocketPtzLanc.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Input.Sdl\Cgf.CameraControl.Input.Sdl.csproj" />
  </ItemGroup>
</Project>
