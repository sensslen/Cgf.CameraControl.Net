<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CgfCameraControl</AssemblyName>
    <RootNamespace>Cgf.CameraControl.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Reflection-based bindings are silently dropped by trimming, so every binding compiles. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Label="NativeAOT">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <TrimMode>full</TrimMode>
    <IsAotCompatible>true</IsAotCompatible>
    <!--
      AtemSharp builds its command registry with Assembly.GetTypes() and then reflects over the
      resolved command type. ILLink.Descriptors.xml in Cgf.CameraControl.Atem preserves that
      assembly whole, so the pattern is safe here but still trips the analyzer. The published
      binary is checked with the aot-probe switch, which fails loudly if the registry ever comes
      up empty.
    -->
    <NoWarn>$(NoWarn);IL2026;IL2075;IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="AtemSharp" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Manifest resources, not resx satellites: NativeAOT does not load satellite assemblies. -->
    <EmbeddedResource Include="Localization\Strings\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by nuget-license and checked by CI, then compiled into the assembly by the licence
         source generator along with the text of every licence it names, so the notices shown cannot
         drift from what the application ships and showing them costs nothing at run time. -->
    <AdditionalFiles Include="Licenses\*.json" />
    <AdditionalFiles Include="Licenses\texts\**\*.txt" />
    <ProjectReference Include="..\Cgf.CameraControl.Licenses.Generator\Cgf.CameraControl.Licenses.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cgf.CameraControl.Core\Cgf.CameraControl.Core.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Atem\Cgf.CameraControl.Atem.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Cameras.SignalrPtzLanc\Cgf.CameraControl.Cameras.SignalrPtzLanc.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Cameras.ViscaOverIp\Cgf.CameraControl.Cameras.ViscaOverIp.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Cameras.WebsocketPtzLanc\Cgf.CameraControl.Cameras.WebsocketPtzLanc.csproj" />
    <ProjectReference Include="..\Cgf.CameraControl.Input.Sdl\Cgf.CameraControl.Input.Sdl.csproj" />
  </ItemGroup>
</Project>
