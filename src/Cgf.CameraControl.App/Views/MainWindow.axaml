<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cgf.CameraControl.App.ViewModels"
        xmlns:hosting="using:Cgf.CameraControl.App.Hosting"
        xmlns:loc="using:Cgf.CameraControl.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
        x:Class="Cgf.CameraControl.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="780"
        Icon="/Assets/appicon.ico"
        Title="{Binding Strings[app.title]^}"
        FlowDirection="{Binding Strings.FlowDirection^}"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur"
        WindowDecorationsTheme="{StaticResource CameraControlWindowDecorations}">

  <Window.Resources>
    <DataTemplate x:Key="MixerTile" x:DataType="vm:MixerViewModel">
      <Border Classes="card">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Classes="lamp" Classes.connected="{Binding IsConnected}" />
            <TextBlock Text="{Binding ConnectionString}" />
          </StackPanel>
          <TextBlock Classes="detail" Margin="16,2,0,0">
            <Run Text="{Binding [mixer.preview]^, Source={x:Static loc:Localizer.Current}}" /><Run Text=" " /><Run Text="{Binding Preview}" />
            <Run Text="   " /><Run Text="{Binding [mixer.program]^, Source={x:Static loc:Localizer.Current}}" /><Run Text=" " /><Run Text="{Binding Program}" />
          </TextBlock>
          <TextBlock Classes="detail" Margin="16,0,0,0" Text="{Binding [mixer.onAir]^, Source={x:Static loc:Localizer.Current}}"
                     IsVisible="{Binding IsPreviewOnAir}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CameraTile" x:DataType="vm:CameraViewModel">
      <Border Classes="card">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Classes="lamp" Classes.connected="{Binding IsConnected}" />
            <TextBlock Text="{Binding ConnectionString}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Classes="detail" Margin="16,2,0,0" Text="{Binding MovementText}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.detail">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- An interface header is a button that looks like the card around it, because clicking it is
         what opens the control window. -->
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.tile:pointerover Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>
    <Style Selector="Border.problem">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- The collapsed bar keeps a lane of its own rather than lying over the last few characters of
         a line. Expanded it does overlap, so it takes a backdrop to stay legible over whatever is
         under it. -->
    <Style Selector="ScrollBar:vertical:expanded">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Border.lamp">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="#4d4d4d" />
    </Style>
    <Style Selector="Border.lamp.connected">
      <Setter Property="Background" Value="#2ecc71" />
    </Style>
  </Window.Styles>

  <!-- The interfaces are the desk; the log is a strip to glance at, and the splitter moves it. -->
  <Grid Name="Root" RowDefinitions="Auto,Auto,3*,Auto,*">

    <!-- The title bar itself. The client area is extended into it and the decorations theme leaves
         it empty, so this is what the user sees up there. Marked as the drag region because the
         theme's own drag panel sits underneath the window content. -->
    <Grid Grid.Row="0" Name="CaptionStrip" Height="40" ColumnDefinitions="Auto,Auto,*,Auto"
          Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
      <Image Grid.Column="0" Source="/Assets/appicon.png" Width="16" Height="16"
             Margin="14,0,10,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="detail" Text="{Binding Strings[app.title]^}"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
      <!-- The strip around it is the drag region, and a drag region swallows the clicks its children
           would otherwise get. This is an element of the decorations rather than part of the handle,
           which is the same thing the caption buttons say about themselves. -->
      <Menu Grid.Column="2" Name="InWindowMenu" Background="Transparent"
            WindowDecorationProperties.ElementRole="DecorationsElement"
            HorizontalAlignment="Left" VerticalAlignment="Center">
      <MenuItem Header="{Binding Strings[menu.file]^}">
        <MenuItem Header="{Binding Strings[config.import]^}" Command="{Binding ImportCommand}"
                  IsEnabled="{Binding !IsBusy}" />
        <MenuItem Header="{Binding Strings[config.reload]^}" Command="{Binding ReloadCommand}"
                  IsEnabled="{Binding !IsBusy}" />
      </MenuItem>
      <MenuItem Header="{Binding Strings[language.label]^}" ItemsSource="{Binding Languages}">
        <MenuItem.ItemContainerTheme>
          <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                        x:DataType="vm:LanguageViewModel">
            <Setter Property="Header" Value="{Binding Display}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="ToggleType" Value="Radio" />
            <Setter Property="IsChecked" Value="{Binding IsActive}" />
          </ControlTheme>
        </MenuItem.ItemContainerTheme>
      </MenuItem>
      <MenuItem Header="{Binding Strings[menu.help]^}">
        <MenuItem Header="{Binding Strings[licenses.label]^}" Command="{Binding ShowLicensesCommand}" />
      </MenuItem>
      </Menu>
      <!-- Kept clear for the caption buttons the decorations theme draws over this strip. -->
      <Panel Grid.Column="3" Width="138" />
    </Grid>

    <StackPanel Grid.Row="1" Margin="16,4,16,12">
      <SelectableTextBlock Classes="detail" Text="{Binding ConfigPath}" TextTrimming="CharacterEllipsis" />
      <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Issues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Classes="problem">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer Grid.Row="2" Margin="16,0,16,0" Padding="0,0,8,0">
      <StackPanel>

        <TextBlock Classes="heading" Text="{Binding Strings[panel.interfaces]^}" />
        <TextBlock Classes="detail" Margin="0,0,0,6" Text="{Binding Strings[interface.clickHint]^}" />

        <ItemsControl ItemsSource="{Binding Interfaces}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InterfaceViewModel">
              <Border Classes="card">
                <StackPanel>

                  <Button Classes="tile">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Border Classes="lamp" Classes.connected="{Binding IsConnected}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Classes="detail" Margin="16,2,0,0" IsVisible="{Binding !IsConnected}"
                                 Text="{Binding [interface.disconnected]^, Source={x:Static loc:Localizer.Current}}" />
                    </StackPanel>
                  </Button>

                  <!-- Open, because an interface drawn as two shut drawers shows nothing at all. -->
                  <Expander Margin="0,8,0,0" HorizontalAlignment="Stretch" IsExpanded="True"
                            Header="{Binding [panel.mixers]^, Source={x:Static loc:Localizer.Current}}">
                    <ItemsControl ItemsSource="{Binding Mixers}" ItemTemplate="{StaticResource MixerTile}" />
                  </Expander>

                  <Expander Margin="0,4,0,0" HorizontalAlignment="Stretch" IsExpanded="True"
                            Header="{Binding [panel.cameras]^, Source={x:Static loc:Localizer.Current}}">
                    <ItemsControl ItemsSource="{Binding Cameras}" ItemTemplate="{StaticResource CameraTile}" />
                  </Expander>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Nothing here belongs to an interface, so nothing here can be driven. It is drawn anyway,
             because a camera missing from the panel reads as one that failed to load. -->
        <Expander Margin="0,4,0,0" HorizontalAlignment="Stretch" IsVisible="{Binding HasUnassigned}"
                  Header="{Binding Strings[panel.unassigned]^}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding UnassignedMixers}" ItemTemplate="{StaticResource MixerTile}" />
            <ItemsControl ItemsSource="{Binding UnassignedCameras}" ItemTemplate="{StaticResource CameraTile}" />
          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>

    <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

    <DockPanel Grid.Row="4" DataContext="{Binding Log}" x:DataType="vm:LogViewModel" Margin="16,0,16,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Classes="heading" Text="{Binding [panel.log]^, Source={x:Static loc:Localizer.Current}}" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="160" Margin="0,0,0,6"
                    ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LogSource">
                <TextBlock Text="{Binding Display^}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Border Classes="card">
          <ScrollViewer Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="hosting:LogEntry">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Column="0" Classes="detail" Text="{Binding Time}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Classes="detail" Text="{Binding Source}" Margin="0,0,8,0"
                               MinWidth="140" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
    </DockPanel>

  </Grid>

</Window>
