<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Cgf.CameraControl.App.Views"
        xmlns:vm="using:Cgf.CameraControl.App.ViewModels"
        xmlns:edit="using:Cgf.CameraControl.App.Editing"
        xmlns:hosting="using:Cgf.CameraControl.App.Hosting"
        xmlns:loc="using:Cgf.CameraControl.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
        x:Class="Cgf.CameraControl.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1100" Height="780" Classes.editing="{Binding IsEditing}"
        Icon="/Assets/appicon.ico"
        Title="{Binding Strings[app.title]^}"
        FlowDirection="{Binding Strings.FlowDirection^}"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur"
        WindowDecorationsTheme="{StaticResource CameraControlWindowDecorations}">

  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{Binding Strings[menu.file]^}">
        <NativeMenu>
          <NativeMenuItem Header="{Binding Strings[config.import]^}" Command="{Binding ImportCommand}"
                          IsEnabled="{Binding CanUseFileMenu}" />
          <NativeMenuItem Header="{Binding Strings[config.reload]^}" Command="{Binding ReloadCommand}"
                          IsEnabled="{Binding CanUseFileMenu}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{Binding Strings[edit.mode]^}" Command="{Binding ToggleEditCommand}"
                          ToggleType="CheckBox" IsChecked="{Binding IsEditing}" IsEnabled="{Binding !IsBusy}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{Binding Strings[language.label]^}">
        <NativeMenu>
          <NativeMenuItem Header="{Binding Languages[0].Display}" Command="{Binding Languages[0].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[0].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[1].Display}" Command="{Binding Languages[1].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[1].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[2].Display}" Command="{Binding Languages[2].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[2].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[3].Display}" Command="{Binding Languages[3].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[3].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[4].Display}" Command="{Binding Languages[4].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[4].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[5].Display}" Command="{Binding Languages[5].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[5].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[6].Display}" Command="{Binding Languages[6].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[6].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[7].Display}" Command="{Binding Languages[7].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[7].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[8].Display}" Command="{Binding Languages[8].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[8].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[9].Display}" Command="{Binding Languages[9].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[9].IsActive}" />
          <NativeMenuItem Header="{Binding Languages[10].Display}" Command="{Binding Languages[10].SelectCommand}"
                          ToggleType="Radio" IsChecked="{Binding Languages[10].IsActive}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="{Binding Strings[menu.help]^}">
        <NativeMenu>
          <NativeMenuItem Header="{Binding Strings[licenses.label]^}" Command="{Binding ShowLicensesCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Window.Resources>
    <ControlTheme x:Key="CameraColorPopover" TargetType="FlyoutPresenter"
                  BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid FlowDirection="LeftToRight">
            <Border Margin="10,0" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 4 16 0 #40000000">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              </ScrollViewer>
            </Border>
            <Canvas IsHitTestVisible="False">
              <Panel Name="LeftPointer" Width="11" Height="20" IsVisible="False">
                <Path Data="M11,0 L0,10 L11,20 Z" Fill="{TemplateBinding Background}" />
                <Path Data="M11,0 L0,10 L11,20" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
              </Panel>
              <Panel Name="RightPointer" Width="11" Height="20" IsVisible="False">
                <Path Data="M0,0 L11,10 L0,20 Z" Fill="{TemplateBinding Background}" />
                <Path Data="M0,0 L11,10 L0,20" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />
              </Panel>
            </Canvas>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <DataTemplate x:Key="MixerTile" x:DataType="vm:MixerViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2" ToolTip.Tip="{Binding ConnectionString}">
        <Border Grid.Column="0" Classes="lamp" Classes.connected="{Binding IsConnected}" />
        <TextBlock Grid.Column="1" Text="{Binding ConnectionString}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="detail" Margin="8,0,0,0" VerticalAlignment="Center">
          <Run Text="{Binding [mixer.preview]^, Source={x:Static loc:Localizer.Current}}" /><Run Text=" " /><Run Text="{Binding Preview}" />
          <Run Text="  " /><Run Text="{Binding [mixer.program]^, Source={x:Static loc:Localizer.Current}}" /><Run Text=" " /><Run Text="{Binding Program}" />
        </TextBlock>
        <TextBlock Grid.Column="3" Classes="detail" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding [mixer.onAir]^, Source={x:Static loc:Localizer.Current}}"
                   IsVisible="{Binding IsPreviewOnAir}" />
      </Grid>
    </DataTemplate>

    <!-- One line per camera, so a full rig fits in a glance; the full address stays in the tooltip
         when the line has to cut it short. -->
    <DataTemplate x:Key="CameraTile" x:DataType="vm:CameraViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2" ToolTip.Tip="{Binding ConnectionString}">
        <Border Grid.Column="0" Classes="lamp" Classes.connected="{Binding IsConnected}" />
        <TextBlock Grid.Column="1" Text="{Binding ConnectionString}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="detail" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding MovementText}" />
        <Button Grid.Column="3" Name="ColorCorrectionButton" Margin="8,0,0,0" Padding="5"
                IsVisible="{Binding SupportsColorCorrection}" IsEnabled="{Binding IsConnected}"
                AutomationProperties.Name="{Binding [color.title]^, Source={x:Static loc:Localizer.Current}}"
                ToolTip.Tip="{Binding [color.title]^, Source={x:Static loc:Localizer.Current}}">
          <Button.Flyout>
            <Flyout Placement="Left" ShowMode="Standard"
                    FlyoutPresenterTheme="{StaticResource CameraColorPopover}"
                    Opening="ColorCorrectionOpening" Opened="ColorCorrectionOpened" Closed="ColorCorrectionClosed">
              <views:CameraColorView DataContext="{Binding}" />
            </Flyout>
          </Button.Flyout>
          <Panel Width="18" Height="18">
            <Path Data="M9,9 L9,0 A9,9 0 0 1 16.794,4.5 Z" Fill="#EF5350" />
            <Path Data="M9,9 L16.794,4.5 A9,9 0 0 1 16.794,13.5 Z" Fill="#FFCA28" />
            <Path Data="M9,9 L16.794,13.5 A9,9 0 0 1 9,18 Z" Fill="#66BB6A" />
            <Path Data="M9,9 L9,18 A9,9 0 0 1 1.206,13.5 Z" Fill="#26C6DA" />
            <Path Data="M9,9 L1.206,13.5 A9,9 0 0 1 1.206,4.5 Z" Fill="#42A5F5" />
            <Path Data="M9,9 L1.206,4.5 A9,9 0 0 1 9,0 Z" Fill="#AB47BC" />
            <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Fill="{DynamicResource SystemControlBackgroundAltHighBrush}" />
          </Panel>
        </Button>
      </Grid>
    </DataTemplate>

    <!-- One interface, drawn. A pad is watched and a keyboard is worked, which is the whole
         difference between the two kinds, so the strip above them is the only part they share. -->
    <DataTemplate x:Key="InterfacePanel" x:DataType="vm:InterfaceViewModel">
      <DockPanel>

        <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,10"
                IsVisible="{Binding ShowsSelection}">
          <Grid ColumnDefinitions="Auto,*,24,Auto,*">
            <TextBlock Grid.Column="0" Classes="detail" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding [surface.program]^, Source={x:Static loc:Localizer.Current}}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding ProgramText}" />
            <TextBlock Grid.Column="3" Classes="detail" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding [surface.preview]^, Source={x:Static loc:Localizer.Current}}" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding PreviewText}" />
          </Grid>
        </Border>

        <!-- Both fill the same space and only one is ever visible. Docked instead, the wireframe
             would be sized to what it asks for, which for a control that only paints is nothing. -->
        <Panel>
          <views:GamepadWireframe IsVisible="{Binding IsGamepad}" />

          <views:ControlSurfaceView IsVisible="{Binding !IsGamepad}" />
        </Panel>

      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="EntryTile" x:DataType="edit:EntryDraft">
      <Grid ColumnDefinitions="*,8,Auto">
        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock FontSize="12" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                     TextWrapping="Wrap" Text="{Binding Problem}"
                     IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <Button Grid.Column="2" Content="&#x2715;" Padding="8,4" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding [edit.delete]^, Source={x:Static loc:Localizer.Current}}"
                ToolTip.Tip="{Binding [edit.delete]^, Source={x:Static loc:Localizer.Current}}"
                Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).DeleteEntryCommand}"
                CommandParameter="{Binding}" />
      </Grid>
    </DataTemplate>

  </Window.Resources>

  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Window[ActualTransparencyLevel=None]">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="Window.editing">
      <Setter Property="MinWidth" Value="960" />
      <Setter Property="MinHeight" Value="600" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.detail">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.surface, Border.selection">
      <Setter Property="Background" Value="{DynamicResource SystemRegionColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.selection">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="BorderThickness" Value="0,1,1,1" />
      <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <Style Selector="Border.editorNavigation">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="Border.editorSurface">
      <Setter Property="Padding" Value="24,20" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.editorEntries">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.editorEntries > ListBoxItem">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.problem">
      <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- The collapsed bar keeps a lane of its own rather than lying over the last few characters of
         a line. Expanded it does overlap, so it takes a backdrop to stay legible over whatever is
         under it. -->
    <Style Selector="ScrollBar:vertical:expanded">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <!-- Yellow rather than grey for something that is not there. Grey reads as switched off and
         accounted for, which is the wrong thing to say about a camera that should be answering.
         On a group lamp it also covers the half-up case, where some are there and some are not. -->
    <Style Selector="Border.lamp">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="#F1C40F" />
    </Style>
    <Style Selector="Border.lamp.connected">
      <Setter Property="Background" Value="#2ecc71" />
    </Style>
    <!-- Preview and program are the two colours a video desk is read in, and an operator reads them
         without being told which is which. -->
    <Style Selector="Border.tally">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Border.tally.preview">
      <Setter Property="Background" Value="#2ECC71" />
    </Style>
    <Style Selector="Border.tally.program">
      <Setter Property="Background" Value="#E74C3C" />
    </Style>
  </Window.Styles>

  <!-- Interfaces on the left pick what fills the middle and what the keyboard drives. The mixers and
       cameras sit under it as two shut drawers with a lamp each, because a desk that is up needs no
       more than that, and the log is a strip to glance at. -->
  <Grid Name="Root" RowDefinitions="Auto,Auto,Auto,3*,Auto,*">

    <!-- The title bar itself. The client area is extended into it and the decorations theme leaves
         it empty, so this is what the user sees up there. Marked as the drag region because the
         theme's own drag panel sits underneath the window content. -->
    <Grid Grid.Row="0" Name="CaptionStrip" Height="40" ColumnDefinitions="Auto,Auto,*,Auto"
          Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
      <Image Grid.Column="0" Source="/Assets/appicon.png" Width="16" Height="16"
             Margin="14,0,10,0" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="detail" Text="{Binding Strings[app.title]^}"
                 VerticalAlignment="Center" Margin="0,0,12,0" />
      <!-- The strip around it is the drag region, and a drag region swallows the clicks its children
           would otherwise get. This is an element of the decorations rather than part of the handle,
           which is the same thing the caption buttons say about themselves. -->
      <Menu Grid.Column="2" Name="InWindowMenu"
            WindowDecorationProperties.ElementRole="DecorationsElement"
            HorizontalAlignment="Left" VerticalAlignment="Center">
        <MenuItem Header="{Binding Strings[menu.file]^}">
          <MenuItem Header="{Binding Strings[config.import]^}" Command="{Binding ImportCommand}"
                    IsEnabled="{Binding CanUseFileMenu}" />
          <MenuItem Header="{Binding Strings[config.reload]^}" Command="{Binding ReloadCommand}"
                    IsEnabled="{Binding CanUseFileMenu}" />
          <Separator />
          <MenuItem Header="{Binding Strings[edit.mode]^}" Command="{Binding ToggleEditCommand}"
                    ToggleType="CheckBox" IsChecked="{Binding IsEditing}" IsEnabled="{Binding !IsBusy}" />
        </MenuItem>
        <MenuItem Header="{Binding Strings[language.label]^}" ItemsSource="{Binding Languages}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                          x:DataType="vm:LanguageViewModel">
              <Setter Property="Header" Value="{Binding Display}" />
              <Setter Property="Command" Value="{Binding SelectCommand}" />
              <Setter Property="ToggleType" Value="Radio" />
              <Setter Property="IsChecked" Value="{Binding IsActive}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <MenuItem Header="{Binding Strings[menu.help]^}">
          <MenuItem Header="{Binding Strings[licenses.label]^}" Command="{Binding ShowLicensesCommand}" />
        </MenuItem>
      </Menu>
      <!-- Kept clear for the caption buttons the decorations theme draws over this strip. -->
      <Panel Grid.Column="3" Width="138" />
    </Grid>

    <!-- The mode has to be impossible to miss: it stops the desk, and every click in the window
         changes a file rather than a camera. The bar carries the way out, so leaving is where
         entering was. -->
    <Border Grid.Row="1" IsVisible="{Binding IsEditing}"
            Background="#22F2B01E" BorderBrush="#80F2B01E" BorderThickness="1"
            CornerRadius="8" Margin="16,4,16,8">
      <Grid ColumnDefinitions="*,Auto" Margin="16,8">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{Binding Strings[edit.banner]^}" />
        <Button Grid.Column="1" Classes="accent" MinWidth="96" Margin="12,0,0,0" HorizontalContentAlignment="Center"
                Command="{Binding ToggleEditCommand}" Content="{Binding Strings[edit.done]^}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="16,4,16,12">
      <SelectableTextBlock Classes="detail" Text="{Binding ConfigPath}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <DockPanel Grid.Row="3" Margin="16,0,16,0">

      <!-- Nothing is connected while the configuration is being edited, so there is nothing for the
           two drawers to report. They open into the interface area rather than the log's, so the
           log stays in sight while they are out. -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,12,*" Margin="0,8,0,0"
            IsVisible="{Binding !IsEditing}">
        <Expander Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  IsExpanded="{Binding AreDevicesExpanded, Mode=TwoWay}">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <Border Classes="lamp" Classes.connected="{Binding AllMixersConnected}" />
              <TextBlock Text="{Binding Strings[panel.mixers]^}" />
            </StackPanel>
          </Expander.Header>
          <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl Padding="0,0,8,0" ItemsSource="{Binding Mixers}"
                          ItemTemplate="{StaticResource MixerTile}" />
          </ScrollViewer>
        </Expander>
        <Expander Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  IsExpanded="{Binding AreDevicesExpanded, Mode=TwoWay}">
          <Expander.Header>
            <StackPanel Orientation="Horizontal">
              <Border Classes="lamp" Classes.connected="{Binding AllCamerasConnected}" />
              <TextBlock Text="{Binding Strings[panel.cameras]^}" />
            </StackPanel>
          </Expander.Header>
          <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl Padding="0,0,8,0" ItemsSource="{Binding Cameras}"
                          ItemTemplate="{StaticResource CameraTile}" />
          </ScrollViewer>
        </Expander>
      </Grid>

      <!-- Every collection in the file, each with its own add at the foot of it. One selection between
           the three, because one editor fills the area they all point at. -->
      <Border DockPanel.Dock="Left" Width="260" IsVisible="{Binding IsEditing}"
              Classes="selection editorNavigation">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Classes="heading" Text="{Binding Strings[panel.interfaces]^}" />
          <ListBox Classes="editorEntries" ItemsSource="{Binding Draft.Interfaces}" SelectedItem="{Binding SelectedInterfaceEntry}"
                   ItemTemplate="{StaticResource EntryTile}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,16"
                  Command="{Binding AddInterfaceCommand}" Content="{Binding Strings[edit.add]^}" />

          <TextBlock Classes="heading" Text="{Binding Strings[panel.cameras]^}" />
          <ListBox Classes="editorEntries" ItemsSource="{Binding Draft.Cameras}" SelectedItem="{Binding SelectedCamera}"
                   ItemTemplate="{StaticResource EntryTile}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,16"
                  Command="{Binding AddCameraCommand}" Content="{Binding Strings[edit.add]^}" />

          <TextBlock Classes="heading" Text="{Binding Strings[panel.mixers]^}" />
          <ListBox Classes="editorEntries" ItemsSource="{Binding Draft.Mixers}" SelectedItem="{Binding SelectedMixer}"
                   ItemTemplate="{StaticResource EntryTile}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,16"
                  Command="{Binding AddMixerCommand}" Content="{Binding Strings[edit.add]^}" />
        </StackPanel>
      </ScrollViewer>
      </Border>

      <Border DockPanel.Dock="Left" Width="220" IsVisible="{Binding !IsEditing}"
              Classes="selection" CornerRadius="6,0,0,6" Padding="8,8,0,8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="heading" Margin="0,0,8,6"
                   Text="{Binding Strings[panel.interfaces]^}" />
        <TextBlock DockPanel.Dock="Bottom" Classes="detail" TextWrapping="Wrap" Margin="0,6,8,0"
                   Text="{Binding Strings[interface.clickHint]^}" />
        <ListBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:InterfaceViewModel">
              <StackPanel Orientation="Horizontal">
                <Border Classes="lamp" Classes.connected="{Binding IsConnected}" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      </Border>

      <!-- Focusable, because this is where a key press reaches the selected interface. The panel
           fills whatever the list leaves, which a star column would not: it hands the panel its
           desired width and lets the pads run off the side of the window. -->
      <Border Classes="surface" Classes.editorSurface="{Binding IsEditing}">
      <Panel>
        <ContentControl Name="Stage" Focusable="True" IsVisible="{Binding !IsEditing}"
                        Content="{Binding SelectedInterface}"
                        ContentTemplate="{StaticResource InterfacePanel}" />

        <Panel IsVisible="{Binding IsEditing}">
          <views:EntryEditorView DataContext="{Binding SelectedEntry}"
                                 IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                     MaxWidth="360" FontSize="16" TextAlignment="Center"
                     IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}"
                     Text="{Binding Strings[edit.nothingSelected]^}" />
        </Panel>
      </Panel>
      </Border>

    </DockPanel>

    <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" />

    <DockPanel Grid.Row="5" Margin="16,0,16,16">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" DataContext="{Binding Log}"
            x:DataType="vm:LogViewModel">
        <TextBlock Grid.Column="0" Classes="heading" VerticalAlignment="Center"
                   Text="{Binding [panel.log]^, Source={x:Static loc:Localizer.Current}}" />
        <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="160" Margin="0,0,0,6"
                  ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogSource">
              <TextBlock Text="{Binding Display^}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <Border Classes="card" DataContext="{Binding Log}" x:DataType="vm:LogViewModel">
        <ScrollViewer Padding="0,0,8,0">
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="hosting:LogEntry">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <TextBlock Grid.Column="0" Classes="detail" Text="{Binding Time}" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Classes="detail" Text="{Binding Source}" Margin="0,0,8,0"
                             MinWidth="140" />
                  <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

    </DockPanel>

  </Grid>

</Window>
