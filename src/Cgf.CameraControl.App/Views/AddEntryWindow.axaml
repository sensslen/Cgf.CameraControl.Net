<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="using:Cgf.CameraControl.App.Editing"
        xmlns:loc="using:Cgf.CameraControl.App.Localization"
        xmlns:views="using:Cgf.CameraControl.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        x:Class="Cgf.CameraControl.App.Views.AddEntryWindow"
        x:DataType="edit:NewEntry"
        Width="600" Height="540" MinWidth="540" MinHeight="400"
        Icon="/Assets/appicon.ico"
        Title="{Binding [edit.addTitle]^, Source={x:Static loc:Localizer.Current}}"
        FlowDirection="{Binding FlowDirection^, Source={x:Static loc:Localizer.Current}}"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="20">

    <!-- The type first, because it decides which fields there are to fill. Changing it starts the
         entry again rather than carrying values into a shape with no room for them. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="180,12,*" Margin="0,0,0,20">
      <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                 Text="{Binding [edit.type]^, Source={x:Static loc:Localizer.Current}}" />
      <ComboBox Grid.Column="2" Width="280" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                AutomationProperties.Name="{Binding [edit.type]^, Source={x:Static loc:Localizer.Current}}" />
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0" Spacing="8">
      <Button Name="Accept" Classes="accent" MinWidth="96" IsDefault="True" IsEnabled="{Binding CanAdd}"
              HorizontalContentAlignment="Center"
              Content="{Binding [edit.add]^, Source={x:Static loc:Localizer.Current}}" />
      <Button Name="Reject" MinWidth="96" HorizontalContentAlignment="Center"
              Content="{Binding [edit.cancel]^, Source={x:Static loc:Localizer.Current}}" />
    </StackPanel>

    <views:EntryEditorView DataContext="{Binding Entry}" />

  </DockPanel>

</Window>
