<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:licenses="using:Cgf.CameraControl.App.Licenses"
        xmlns:loc="using:Cgf.CameraControl.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="680"
        x:Class="Cgf.CameraControl.App.Views.LicensesWindow"
        x:DataType="loc:Localizer"
        Width="620" Height="680"
        Icon="/Assets/appicon.ico"
        WindowStartupLocation="CenterOwner"
        Title="{Binding [licenses.label]^}"
        FlowDirection="{Binding FlowDirection^}">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The collapsed bar keeps a lane of its own rather than lying over the last few characters of
         a line. Expanded it does overlap, so it takes a backdrop to stay legible over whatever is
         under it. -->
    <Style Selector="ScrollBar:vertical:expanded">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{Binding [licenses.app]^}" TextWrapping="Wrap" />
      <TextBlock Margin="0,8,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                 Text="{Binding [licenses.intro]^}" />
    </StackPanel>

    <ScrollViewer Padding="0,0,8,0">
      <ItemsControl ItemsSource="{x:Static licenses:ThirdPartyLicenses.All}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="licenses:ThirdPartyLicense">
            <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
              <Expander.Header>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="label" Margin="12,0,0,0"
                             Text="{Binding License}" VerticalAlignment="Center" />
                </Grid>
              </Expander.Header>

              <StackPanel>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="label"
                             Text="{Binding [licenses.license]^, Source={x:Static loc:Localizer.Current}}" />
                  <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding License}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="label"
                             IsVisible="{Binding Copyright, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Text="{Binding [licenses.copyright]^, Source={x:Static loc:Localizer.Current}}" />
                  <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Copyright}"
                                       IsVisible="{Binding Copyright, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="label"
                             IsVisible="{Binding Authors, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Text="{Binding [licenses.authors]^, Source={x:Static loc:Localizer.Current}}" />
                  <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Authors}"
                                       IsVisible="{Binding Authors, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="label"
                             IsVisible="{Binding ProjectUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                             Text="{Binding [licenses.project]^, Source={x:Static loc:Localizer.Current}}" />
                  <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding ProjectUrl}"
                                       IsVisible="{Binding ProjectUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>

                <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                  <!-- The generator has already made each paragraph one line, so this is the only
                       wrapping the text gets. -->
                  <SelectableTextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</Window>
