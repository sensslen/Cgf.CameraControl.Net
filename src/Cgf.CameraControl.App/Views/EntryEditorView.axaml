<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="using:Cgf.CameraControl.App.Editing"
             xmlns:loc="using:Cgf.CameraControl.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="460"
             x:Class="Cgf.CameraControl.App.Views.EntryEditorView"
             x:DataType="edit:EntryDraft">

  <UserControl.Resources>
    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
    <GridLength x:Key="SliderPostContentMargin">0</GridLength>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Grid.field">
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.wrong">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.value, AutoCompleteBox.value, ComboBox.value">
      <Setter Property="Width" Value="280" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.remove">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="AutomationProperties.Name" Value="{Binding [edit.delete]^, Source={x:Static loc:Localizer.Current}}" />
      <Setter Property="ToolTip.Tip" Value="{Binding [edit.delete]^, Source={x:Static loc:Localizer.Current}}" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="edit:TextField">
      <Grid Classes="field" ColumnDefinitions="180,12,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="caption" Text="{Binding Caption^}" />
        <TextBox Grid.Column="2" Classes="value" Text="{Binding Value}" PlaceholderText="{Binding Hint^}"
                 AutomationProperties.Name="{Binding Caption^}" IsVisible="{Binding !HasSuggestions}" />
        <AutoCompleteBox Grid.Column="2" Classes="value" Text="{Binding Value}" PlaceholderText="{Binding Hint^}"
                         AutomationProperties.Name="{Binding Caption^}" IsVisible="{Binding HasSuggestions}"
                         ItemsSource="{Binding Suggestions}" MinimumPrefixLength="0"
                         FilterMode="Contains" IsTextCompletionEnabled="False" />
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="wrong" Text="{Binding Error}"
                   AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="edit:NumberField">
      <Grid Classes="field" ColumnDefinitions="180,12,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="caption" Text="{Binding Caption^}" />
        <TextBox Grid.Column="2" Width="120" HorizontalAlignment="Left"
                 Text="{Binding Value}" PlaceholderText="{Binding Hint^}" AutomationProperties.Name="{Binding Caption^}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="wrong" Text="{Binding Error}"
                   AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="edit:FractionField">
      <Grid Classes="field" ColumnDefinitions="180,12,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="caption" Text="{Binding Caption^}" />
        <TextBox Grid.Column="2" Width="120" HorizontalAlignment="Left"
                 Text="{Binding Value}" AutomationProperties.Name="{Binding Caption^}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="wrong" Text="{Binding Error}"
                   AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="edit:PercentField">
      <Grid Classes="field" ColumnDefinitions="180,12,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="caption" Text="{Binding Caption^}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Slider Width="160" Minimum="1" Maximum="100" TickFrequency="1"
                  IsSnapToTickEnabled="True" Value="{Binding SliderValue, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Caption^}" VerticalAlignment="Center" />
          <TextBox Width="64" Text="{Binding Value}" AutomationProperties.Name="{Binding Caption^}" />
          <TextBlock Text="%" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="wrong" Text="{Binding Error}"
                   AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="edit:SwitchField">
      <Grid Classes="field" ColumnDefinitions="180,12,*">
        <TextBlock Classes="caption" Text="{Binding Caption^}" />
        <CheckBox Grid.Column="2" IsChecked="{Binding Value}" VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding Caption^}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="edit:ChoiceField">
      <Grid Classes="field" ColumnDefinitions="180,12,*">
        <TextBlock Classes="caption" Text="{Binding Caption^}" />
        <ComboBox Grid.Column="2" Classes="value" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"
                  AutomationProperties.Name="{Binding Caption^}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="edit:MapField">
      <StackPanel Margin="0,8,0,14" Spacing="6">
        <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Caption^}" />
        <Grid ColumnDefinitions="120,8,120,8,Auto">
          <TextBlock Classes="caption" Text="{Binding LeftCaption^}" />
          <TextBlock Grid.Column="2" Classes="caption" Text="{Binding RightCaption^}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="edit:MapRow">
              <Grid ColumnDefinitions="120,8,120,8,Auto" Margin="0,0,0,6">
                <TextBox Text="{Binding Key}">
                  <AutomationProperties.Name>
                    <MultiBinding StringFormat="{}{0} {1}">
                      <Binding Path="$parent[ItemsControl].((edit:MapField)DataContext).LeftCaption^" />
                      <Binding Path="Position" />
                    </MultiBinding>
                  </AutomationProperties.Name>
                </TextBox>
                <TextBox Grid.Column="2" Text="{Binding Value}">
                  <AutomationProperties.Name>
                    <MultiBinding StringFormat="{}{0} {1}">
                      <Binding Path="$parent[ItemsControl].((edit:MapField)DataContext).RightCaption^" />
                      <Binding Path="Position" />
                    </MultiBinding>
                  </AutomationProperties.Name>
                </TextBox>
                <Button Grid.Column="4" Classes="remove" Content="&#x2715;"
                        Command="{Binding $parent[ItemsControl].((edit:MapField)DataContext).RemoveRowCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button HorizontalAlignment="Left" Command="{Binding AddRowCommand}"
                Content="{Binding [edit.add]^, Source={x:Static loc:Localizer.Current}}" />
        <TextBlock Classes="wrong" Text="{Binding Error}" AutomationProperties.LiveSetting="Polite"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20" Spacing="6">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Classes="wrong" Text="{Binding Problem}" AutomationProperties.LiveSetting="Polite"
                 IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl Margin="0,0,12,0" ItemsSource="{Binding Fields}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
