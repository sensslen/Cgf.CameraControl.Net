<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cgf.CameraControl.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="346"
             x:Class="Cgf.CameraControl.App.Views.GamepadWireframe"
             x:DataType="vm:InterfaceViewModel">

  <!-- Every colour is solid. Strokes meet and cross all over the pad, and a see-through colour
       drawn twice is darker where it doubles, so each shade is its own opaque colour per theme. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PadBody" Color="#E4E4E4" />
          <SolidColorBrush x:Key="PadButton" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PadLine" Color="#7A7A7A" />
          <SolidColorBrush x:Key="PadFaintLine" Color="#C4C4C4" />
          <SolidColorBrush x:Key="PadOnLit" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PadLit" Color="#4A9EE0" />
          <SolidColorBrush x:Key="PadPull" Color="#A9CDEE" />
          <SolidColorBrush x:Key="PadRowLit" Color="#DCE9F6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PadBody" Color="#262626" />
          <SolidColorBrush x:Key="PadButton" Color="#0E0E0E" />
          <SolidColorBrush x:Key="PadLine" Color="#9A9A9A" />
          <SolidColorBrush x:Key="PadFaintLine" Color="#4A4A4A" />
          <SolidColorBrush x:Key="PadOnLit" Color="#000000" />
          <SolidColorBrush x:Key="PadLit" Color="#7DB9EC" />
          <SolidColorBrush x:Key="PadPull" Color="#2B5A85" />
          <SolidColorBrush x:Key="PadRowLit" Color="#1E3044" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- The face buttons keep the colours their symbols are known by. A later style wins, so the
       state classes come last and being pressed wins over being live. -->
  <UserControl.Styles>
    <!-- Opaque, because the shoulder bands tuck their unstroked edge under it. -->
    <Style Selector="Path.body">
      <Setter Property="Fill" Value="{DynamicResource PadBody}" />
      <Setter Property="Stroke" Value="{DynamicResource PadLine}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.control">
      <Setter Property="Fill" Value="{DynamicResource PadButton}" />
      <Setter Property="Stroke" Value="{DynamicResource PadLine}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- The hub only fills the middle of the cross; the arms draw its outline. -->
    <Style Selector="Path.hub">
      <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <Style Selector="Path.knob">
      <Setter Property="Fill" Value="{DynamicResource PadLine}" />
    </Style>
    <Style Selector="Path.knob.pressed">
      <Setter Property="Fill" Value="{DynamicResource PadLit}" />
    </Style>

    <Style Selector="Path.mark">
      <Setter Property="Stroke" Value="{DynamicResource PadLine}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.arrow">
      <Setter Property="Fill" Value="{DynamicResource PadLine}" />
    </Style>
    <Style Selector="TextBlock.mark">
      <Setter Property="Foreground" Value="{DynamicResource PadLine}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.triangle">
      <Setter Property="Stroke" Value="#2DB88A" />
    </Style>
    <Style Selector="Path.circle">
      <Setter Property="Stroke" Value="#E5484D" />
    </Style>
    <Style Selector="Path.cross">
      <Setter Property="Stroke" Value="#4C84E8" />
    </Style>
    <Style Selector="Path.square">
      <Setter Property="Stroke" Value="#D274B5" />
    </Style>

    <!-- An unbound control is drawn in faint lines, and so is the whole pad while it is not
         connected, its face symbols losing their colours too. -->
    <Style Selector="Canvas.unbound Path.control, Canvas.unbound Path.mark">
      <Setter Property="Stroke" Value="{DynamicResource PadFaintLine}" />
    </Style>
    <Style Selector="Canvas.unbound Path.arrow">
      <Setter Property="Fill" Value="{DynamicResource PadFaintLine}" />
    </Style>
    <Style Selector="Canvas.unbound TextBlock.mark">
      <Setter Property="Foreground" Value="{DynamicResource PadFaintLine}" />
    </Style>
    <Style Selector="Canvas.disconnected Path.body, Canvas.disconnected Path.control">
      <Setter Property="Stroke" Value="{DynamicResource PadFaintLine}" />
    </Style>
    <Style Selector="Canvas.disconnected Path.mark">
      <Setter Property="Stroke" Value="{DynamicResource PadLine}" />
    </Style>
    <Style Selector="Canvas.preview Path.control">
      <Setter Property="Fill" Value="#2ECC71" />
    </Style>
    <Style Selector="Canvas.program Path.control">
      <Setter Property="Fill" Value="#E74C3C" />
    </Style>
    <Style Selector="Canvas.pressed Path.control">
      <Setter Property="Fill" Value="{DynamicResource PadLit}" />
    </Style>
    <Style Selector="Canvas.pressed.triangle Path.control">
      <Setter Property="Fill" Value="#2DB88A" />
    </Style>
    <Style Selector="Canvas.pressed.circle Path.control">
      <Setter Property="Fill" Value="#E5484D" />
    </Style>
    <Style Selector="Canvas.pressed.cross Path.control">
      <Setter Property="Fill" Value="#4C84E8" />
    </Style>
    <Style Selector="Canvas.pressed.square Path.control">
      <Setter Property="Fill" Value="#D274B5" />
    </Style>
    <!-- A symbol on a lit button is white on a light desk and black on a dark one. -->
    <Style Selector="Canvas.pressed Path.mark">
      <Setter Property="Stroke" Value="{DynamicResource PadOnLit}" />
    </Style>
    <Style Selector="Canvas.pressed Path.arrow, Canvas.preview Path.arrow, Canvas.program Path.arrow">
      <Setter Property="Fill" Value="{DynamicResource PadOnLit}" />
    </Style>
    <Style Selector="Canvas.pressed TextBlock.mark">
      <Setter Property="Foreground" Value="{DynamicResource PadOnLit}" />
    </Style>

    <Style Selector="Border.row">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.pressed">
      <Setter Property="Background" Value="{DynamicResource PadRowLit}" />
    </Style>
    <Style Selector="Border.row Viewbox">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Border.row > StackPanel > TextBlock">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="3*,Auto" Margin="12">
    <!-- The drawing carries the symbols printed on a pad and no other text: each control is
         explained once, in the legend beside it, under the same symbol. -->
    <Viewbox Grid.Column="0" Stretch="Uniform">
      <Canvas Name="Pad" Width="360" Height="216" />
    </Viewbox>

    <ScrollViewer Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="Legend" Spacing="1" />
    </ScrollViewer>
  </Grid>

</UserControl>
